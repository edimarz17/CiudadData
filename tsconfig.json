{
  "compilerOptions": {
    "target": "ES2020",                                  /* Version de JavaScript de salida */
    "module": "commonjs",                                /* Sistema de modulos para Node.js */
    "lib": ["es2020"],                                   /* Librerias disponibles en el entorno */
    "outDir": "./dist",                                  /* Carpeta donde se guardara el codigo compilado */
    "rootDir": "./src",                                  /* Carpeta donde escribiras tu codigo fuente */
    "strict": true,                                      /* Habilita comprobaciones de tipo estrictas */
    "esModuleInterop": true,                             /* Compatibilidad con modulos CommonJS/ES */
    "skipLibCheck": true,                                /* Acelera la compilacion ignorando tipos de librerias */
    "forceConsistentCasingInFileNames": true,            /* Asegura que el casing de archivos sea consistente */
    "moduleResolution": "node",                          /* Resolucion de modulos estilo Node */
    "resolveJsonModule": true,                           /* Permite importar archivos .json */
    "experimentalDecorators": true,                      /* Util si decides usar decoradores con Swagger o Mongoose */
    "emitDecoratorMetadata": true ,
  },                  
  "include": ["src/**/*.test.ts", "src/unit-test/**/*.ts"]      
}